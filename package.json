{
  "name": "peoples-chat",
  "version": "0.1.0",
  "description": "peoples.chat interface: the web front end shown in the Tauri web view",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc",
    "test": "vitest run",
    "tauri": "tauri",
    "verify": "scripts/verify.sh",
    "verify:quick": "scripts/verify.sh --quick",
    "verify:radio": "cargo run --quiet -p peoples-chat-core --example verify_radio --",
    "e2e:build": "VITE_E2E=1 tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "e2e": "pnpm e2e:build && wdio run e2e/wdio.conf.ts",
    "e2e:check": "tsc -p e2e",
    "release:android": "scripts/release/android.sh",
    "release:ios": "scripts/release/ios.sh",
    "version:check": "node scripts/release/version.mjs"
  },
  "dependencies": {
    "@fontsource-variable/albert-sans": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.3",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@wdio/tauri-plugin": "1.5.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.19.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@wdio/cli": "9.33.1",
    "@wdio/globals": "9.33.1",
    "@wdio/local-runner": "9.33.1",
    "@wdio/mocha-framework": "9.33.1",
    "@wdio/spec-reporter": "9.33.1",
    "@wdio/tauri-service": "1.5.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.1",
    "webdriverio": "9.33.1"
  }
}
